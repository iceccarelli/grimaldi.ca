+                    <th scope="col">Pain</th>
+                    <th scope="col">Urgency</th>
+                    <th scope="col">Validation</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {[...evidence].sort((a, b) => b.date.localeCompare(a.date)).map((e) => (
