+    KillEntryList: list('KillEntry'),
+    EvidenceList: list('Evidence'),
+    WorkflowList: list('Workflow'),
+    WeeklyReportList: list('WeeklyReport'),
+    AgentSpecList: list('AgentSpec'),
+    ContractList: list('Contract'),
+    WatchItemList: list('WatchItem'),
+    ResourceEnvelope: {
