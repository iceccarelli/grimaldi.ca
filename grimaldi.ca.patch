+.ch-meta a { color: var(--terra); font-weight: 650; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
+.chapter-nav { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2.5rem; padding-top: 1.2rem; border-top: 1px solid var(--border); font-size: .9rem; font-weight: 600; }
+.chapter-nav a { color: var(--terra); }
+.books { grid-template-columns: 1fr 1fr; }
+.book { box-shadow: none; }
+.book h2 { font-size: 1.35rem; margin: 0; }
+.book h2 a:hover { color: var(--terra); }
+
+/* archive */
+.archive-group { margin-top: 1.5rem; }
+.archive-rows { list-style: none; margin: .6rem 0 0; padding: 0; max-width: 860px; }
+.archive-rows li { display: grid; grid-template-columns: 150px 1fr; gap: 1rem; padding: .85rem 0; border-top: 1px solid var(--border); align-items: start; }
+.archive-rows li:last-child { border-bottom: 1px solid var(--border); }
+.ar-main { display: flex; flex-direction: column; gap: .25rem; }
+.ar-main b { font-family: var(--serif); font-size: 1.02rem; font-weight: 600; }
+.ar-main a:hover b { color: var(--terra); }
+.ar-main > span { font-size: .9rem; color: var(--text-2); line-height: 1.6; }
+.ar-owner { font: 600 .74rem ui-monospace, SFMono-Regular, Menlo, monospace !important; color: var(--muted) !important; }
+.journey { margin-bottom: 1rem; }
+
+/* pointers, subscribe, footer network */
+.pointer-list { list-style: none; margin: 1rem 0; padding: 0; max-width: 760px; }
+.pointer-list li { padding: .8rem 0; border-top: 1px solid var(--border); font-size: 1rem; line-height: 1.6; }
+.pointer-list li:last-child { border-bottom: 1px solid var(--border); }
+.pointer-list a { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-weight: 650; color: var(--terra); }
+.pointer-list span { color: var(--text-2); }
+
+.sub-form { display: flex; flex-direction: column; gap: .7rem; max-width: 560px; margin-top: 1rem; }
+.sub-form.compact { margin-top: .8rem; }
+.sub-label { font-size: .95rem; color: var(--text-2); }
+.sub-row { display: flex; gap: .6rem; flex-wrap: wrap; }
+.sub-row input { flex: 1; min-width: 220px; border: 1px solid var(--border-strong); border-radius: 4px; padding: .68rem .9rem; font-size: .95rem; font-family: inherit; color: var(--ink); background: #fffdf8; }
+.sub-row input:focus { outline: 2px solid rgba(43, 36, 32, 0.5); outline-offset: 1px; }
+.sub-row .btn { border-radius: 4px; cursor: pointer; border: 0; }
+.sub-form .form-err { margin: 0; }
+
+.netfoot p { margin: 0 0 .55rem; font-size: .88rem; color: rgba(246, 239, 228, 0.78); }
+.netfoot a { display: inline; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; color: #f6efe4; margin: 0; }
+.netfoot .hire { margin-top: 1.1rem; }
+.netfoot .hire a { font-family: inherit; color: rgba(246, 239, 228, 0.78); }
+.foot-contact { display: flex; flex-wrap: wrap; gap: .3rem 1rem; }
+.foot-contact a { display: inline; margin: 0; }
+.foot-grid { grid-template-columns: 1fr 1fr; }
+
+.btn, .pill { border-radius: 4px; }
+.nav-toggle { border-radius: 4px; }
+
+@media (max-width: 980px) {
+  .doors { grid-template-columns: 1fr; }
+  .door { border-right: 0; border-bottom: 1px solid var(--border); min-height: 0; }
+  .door:last-child { border-bottom: 0; }
+  .person { flex-direction: column; }
+  .now-row, .toc a, .template > div { grid-template-columns: 1fr; gap: .25rem; }
+  .note-list a, .ep-list a { grid-template-columns: 1fr; gap: .4rem; }
+  .note-meta, .ep-meta { flex-direction: row; align-items: center; }
+  .chapters li, .archive-rows li { grid-template-columns: 1fr; gap: .4rem; }
+  .ch-meta { flex-direction: row; align-items: center; }
+  .foot-grid { grid-template-columns: 1fr; }
+  .masthead { padding: 2.2rem 1.25rem 2rem; }
+}
+.door .badge, .empty .badge { align-self: flex-start; }
+/* the concierge launcher, quietened to match the journal */
+.ask-launcher { background: var(--ink); border-color: var(--ink); box-shadow: 0 4px 14px rgba(43, 36, 32, 0.25); border-radius: 6px; }
+.ask-launcher:hover { box-shadow: 0 6px 18px rgba(43, 36, 32, 0.3); }
+.ask-head { background: var(--ink); }
+.ask-panel { border-radius: 6px; }
